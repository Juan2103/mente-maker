---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Mente-Maker | Punto Creativo</title>
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans selection:bg-purple-200 selection:text-purple-900">
    
    <!-- Barra de Navegación -->
    <nav class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center gap-4">
        
        <!-- Logo Textual (Inspirado en tu imagen) -->
        <a href="#inicio" class="flex flex-col items-center leading-none">
          <div class="text-3xl font-black tracking-tighter">
            <span class="text-[#1a1a3a]">MENTE</span>
            <span class="text-green-500">MAKER</span>
          </div>
          <div class="text-[0.65rem] font-bold tracking-[0.3em] text-purple-700 mt-1 uppercase">
            &bull; Punto Creativo &bull;
          </div>
        </a>

        <!-- Enlaces -->
        <ul class="flex gap-4 md:gap-8 font-semibold text-[#1a1a3a] text-sm md:text-base items-center">
          <li><a href="#inicio" class="hover:text-purple-600 transition">Inicio</a></li>
          <li><a href="#nosotros" class="hover:text-purple-600 transition">Nosotros</a></li>
          <li><a href="#pilares" class="hover:text-purple-600 transition">Pilares</a></li>
          <li>
            <a href="#contacto" class="bg-purple-700 text-white px-5 py-2 rounded-full hover:bg-purple-800 transition shadow-md">
              Únete
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <!-- Hero Section -->
    <header id="inicio" class="bg-white relative overflow-hidden pt-16 pb-24 px-4 scroll-mt-20">
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <!-- Textos -->
        <div class="space-y-8 z-10">
          <h1 class="text-5xl md:text-6xl font-black text-[#1a1a3a] leading-tight uppercase transform -rotate-1">
            No es un lugar. <br/>
            <span class="text-purple-700">Es una forma de pensar,</span><br/>
            crear y <span class="text-green-500">transformar</span> <br/>
            el mundo.
          </h1>
          <div class="flex flex-col gap-2 font-black text-2xl uppercase tracking-wide">
            <span class="text-teal-500">Aprende.</span>
            <span class="text-orange-500">Crea.</span>
            <span class="text-purple-700">Conecta.</span>
            <span class="text-blue-500">Lidera.</span>
            <span class="text-yellow-500">Construye.</span>
            <span class="text-teal-400">Innova.</span>
            <span class="text-[#1a1a3a]">Emprende.</span>
          </div>
        </div>
        
        <!-- Descripción y CTA -->
        <div id="nosotros" class="bg-purple-50 p-8 rounded-3xl border border-purple-100 shadow-xl relative scroll-mt-24">
          <!-- Decoración circular estilo Mente-Maker -->
          <div class="absolute -top-10 -right-10 w-32 h-32 bg-purple-700 rounded-full opacity-10"></div>
          
          <p class="text-xl text-gray-700 leading-relaxed font-medium relative z-10">
            Somos un <span class="text-purple-700 font-bold">movimiento creativo</span> que impulsa personas para convertir ideas en proyectos con propósito y en soluciones que generan un impacto positivo en su comunidad y en el mundo.
          </p>
          <div class="mt-8">
            <a href="#contacto" class="inline-block bg-green-500 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-green-600 transition shadow-[0_4px_14px_0_rgba(16,185,129,0.39)]">
              Descubre nuestros cursos
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Sección de Pilares (Fondo Azul Oscuro con borde superior curvo) -->
    <section id="pilares" class="bg-[#1a1a3a] text-white py-20 px-4 -mt-10 rounded-t-[3rem] relative z-20 scroll-mt-10">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-gray-700">
          
          <!-- P1 -->
          <div class="p-4 flex flex-col items-center">
            <div class="text-teal-400 text-5xl mb-4">👤⭐</div>
            <h3 class="text-teal-400 font-bold text-lg uppercase mb-2">Desarrolla</h3>
            <p class="text-gray-300 text-sm">tus habilidades y descubre tu potencial.</p>
          </div>
          
          <!-- P2 -->
          <div class="p-4 flex flex-col items-center">
            <div class="text-orange-500 text-5xl mb-4">👥</div>
            <h3 class="text-orange-500 font-bold text-lg uppercase mb-2">Conecta</h3>
            <p class="text-gray-300 text-sm">con una comunidad que inspira, colabora y te impulsa.</p>
          </div>
          
          <!-- P3 -->
          <div class="p-4 flex flex-col items-center">
            <div class="text-purple-400 text-5xl mb-4">🧩</div>
            <h3 class="text-purple-400 font-bold text-lg uppercase mb-2">Crea</h3>
            <p class="text-gray-300 text-sm">soluciones innovadoras a problemas reales.</p>
          </div>
          
          <!-- P4 -->
          <div class="p-4 flex flex-col items-center">
            <div class="text-green-400 text-5xl mb-4">🚀</div>
            <h3 class="text-green-400 font-bold text-lg uppercase mb-2">Emprende</h3>
            <p class="text-gray-300 text-sm">proyectos con propósito que generan impacto.</p>
          </div>
          
          <!-- P5 -->
          <div class="p-4 flex flex-col items-center">
            <div class="text-yellow-500 text-5xl mb-4">🧠💡</div>
            <h3 class="text-yellow-500 font-bold text-lg uppercase mb-2">Transforma</h3>
            <p class="text-gray-300 text-sm">tu entorno y sé parte de un futuro mejor para todos.</p>
          </div>

        </div>
      </div>
    </section>

    <!-- Formulario de Contacto y Valores -->
    <section id="contacto" class="bg-gray-100 py-20 px-4 scroll-mt-20">
      <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        
        <!-- Atributos Inferiores (Imagen 2) -->
        <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-200">
          <h3 class="text-2xl font-bold text-[#1a1a3a] mb-8 text-center">Nuestra Filosofía</h3>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <span class="text-3xl">👥</span>
              <div>
                <h4 class="font-bold text-teal-600">COMUNIDAD</h4>
                <p class="text-sm text-gray-600">Creemos en el poder de las personas.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-3xl">🤝</span>
              <div>
                <h4 class="font-bold text-blue-600">INTEGRIDAD</h4>
                <p class="text-sm text-gray-600">Hacemos lo correcto siempre.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-3xl">🚀</span>
              <div>
                <h4 class="font-bold text-purple-600">INNOVACIÓN</h4>
                <p class="text-sm text-gray-600">Rompemos límites, creamos futuro.</p>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="text-3xl">🏔️</span>
              <div>
                <h4 class="font-bold text-green-600">IMPACTO</h4>
                <p class="text-sm text-gray-600">Generamos valor que deja huella.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Formulario -->
        <div class="bg-white p-8 rounded-3xl shadow-xl border-t-4 border-purple-600 relative overflow-hidden">
          <div class="absolute -right-16 -top-16 text-9xl opacity-5">💡</div>
          <h2 class="text-3xl font-black text-[#1a1a3a] mb-2 relative z-10">Únete a Mente-Maker</h2>
          <p class="text-gray-500 mb-8 relative z-10">Déjanos tus datos y te contactaremos vía WhatsApp para darte toda la información de los cursos.</p>
          
          <form id="whatsapp-form" class="space-y-5 relative z-10">
            <div>
              <label for="nombre" class="block font-bold text-gray-700 mb-1">Nombre completo</label>
              <input type="text" id="nombre" required class="w-full bg-gray-50 border-gray-300 border p-3 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none transition" placeholder="Ej. Juan Pérez" />
            </div>
            <div>
              <label for="curso" class="block font-bold text-gray-700 mb-1">Área de interés</label>
              <select id="curso" required class="w-full bg-gray-50 border-gray-300 border p-3 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none transition cursor-pointer">
                <option value="" disabled selected>Selecciona una categoría...</option>
                <option value="Informática">💻 Informática (Desarrollo, Redes, etc.)</option>
                <option value="Contaduría">📊 Contaduría</option>
                <option value="Finanzas">📈 Finanzas</option>
                <option value="Otra">✨ Otra</option>
              </select>
            </div>
            <button type="submit" class="w-full bg-[#128C7E] text-white font-bold py-4 px-4 rounded-xl hover:bg-[#075E54] transition flex justify-center items-center gap-3 shadow-lg mt-4">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              Enviar mensaje por WhatsApp
            </button>
          </form>
        </div>

      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-[#1a1a3a] text-white py-12 px-4 border-t border-gray-800">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
        <div>
          <div class="text-2xl font-black tracking-tighter mb-2">
            <span>MENTE</span><span class="text-green-500">MAKER</span>
          </div>
          <p class="text-gray-400 text-sm">Ideas que aprenden &bull; Talentos que conectan</p>
        </div>
        
        <!-- Redes Sociales (Basado en la parte inferior del flyer) -->
        <div class="flex items-center gap-4 text-xl">
          <span class="text-gray-400 font-medium mr-2">Síguenos:</span>
          <a href="#" class="hover:text-purple-400 transition">📸</a>
          <a href="#" class="hover:text-blue-500 transition">📘</a>
          <a href="#" class="hover:text-red-500 transition">▶️</a>
          <a href="#" class="hover:text-blue-400 transition">💼</a>
          <span class="font-bold text-gray-300 ml-2">@mentemaker.mx</span>
        </div>
      </div>
    </footer>

    <!-- Lógica de WhatsApp -->
    <script>
      const form = document.getElementById('whatsapp-form');
      
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          
          const nombreInput = document.getElementById('nombre') as HTMLInputElement;
          const cursoInput = document.getElementById('curso') as HTMLSelectElement;
          
          const nombre = nombreInput.value;
          const curso = cursoInput.value;
          
          const telefono = "524924471821"; 
          
          const mensaje = `¡Hola Mente-Maker! Soy ${nombre}. Me gustaría recibir más información sobre el movimiento y los cursos en el área de ${curso}.`;
          const mensajeCodificado = encodeURIComponent(mensaje);
          
          const url = `https://wa.me/${telefono}?text=${mensajeCodificado}`;
          window.open(url, '_blank');
        });
      }
    </script>
  </body>
</html>